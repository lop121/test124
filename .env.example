POSTGRES_USER=payments
POSTGRES_PASSWORD=payments-local-only
POSTGRES_DB=payments
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=rabbit-local-only
DATABASE_URL=postgresql+asyncpg://payments:payments-local-only@postgres:5432/payments
RABBITMQ_URL=amqp://payments:rabbit-local-only@rabbitmq:5672/
API_KEY=development-api-key-change-me
WEBHOOK_SECRET=development-webhook-secret-change-me
WEBHOOK_ALLOWED_HOSTS=["demo-webhook","webhook.site"]
# Только для локального demo-webhook; на внешнем окружении установите false.
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_TIMEOUT=5
RETRY_BASE_SECONDS=2
API_PORT=18080
RABBITMQ_MANAGEMENT_PORT=15673
